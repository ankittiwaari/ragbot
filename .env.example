# Postgres (docker-compose)
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=ragbot
POSTGRES_DB=ragbot
POSTGRES_PORT=5432

# App connection string (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://ragbot:ragbot@localhost:5432/ragbot
JWT_SECRET=change-me
# RabbitMQ (docker-compose)
RABBITMQ_USER=ragbot
RABBITMQ_PASSWORD=ragbot
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# App connection string
RABBITMQ_URL=amqp://ragbot:ragbot@localhost:5672/